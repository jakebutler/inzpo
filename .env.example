# Database (Neon, pooled connection string)
DATABASE_URL=

# Cloudflare R2 (private bucket; S3-compatible API)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Owner gate (single-user auth). AUTH_PASSPHRASE: high-entropy passphrase.
# AUTH_SESSION_SECRET: 32+ random bytes, e.g. `openssl rand -base64 48`.
AUTH_PASSPHRASE=
AUTH_SESSION_SECRET=
