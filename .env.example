# Database (Neon, pooled connection string)
# Preview must use a Neon branch — never the production database.
DATABASE_URL=

# Cloudflare R2 (private bucket; S3-compatible API)
# Prefer a preview bucket, not production.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Clerk (development instance for Vercel Preview)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/capture
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/capture

# After Jake signs in once, set this to his Clerk user id (user_...) so
# rows backfilled as legacy-jake stay visible until claimLegacy runs.
JAKE_OWNER_ID=
# Email that may claim pre-Clerk rows (updates owner_id from legacy-jake).
JAKE_EMAIL=

# Reaper cron (app/api/reaper via vercel.json). Vercel sends
# `Authorization: Bearer $CRON_SECRET` on scheduled runs.
CRON_SECRET=

# Local QA only. Never set on Vercel production.
# INZPO_DEV_AUTH=1 skips Clerk and uses INZPO_DEV_OWNER_ID (default e2e-test).
# INZPO_DEV_AUTH=
# INZPO_DEV_OWNER_ID=

# Optional vision brief (DigitalOcean inference). Leave empty to stub.
DO_INFERENCE_API_KEY=
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
BRIEF_MODEL=openai/glm-5.3-flash
